# Copy to .env and adjust. Loaded by app/core/config.py.
APP_ENV=development
LOG_LEVEL=INFO
# console (colored, for development) | json (one object per line, for production)
LOG_FORMAT=console

# PostgreSQL (used by docker-compose and the app)
POSTGRES_USER=docs
POSTGRES_PASSWORD=docs
POSTGRES_DB=docs_extraction
DATABASE_URL=postgresql+psycopg://docs:docs@localhost:5432/docs_extraction

# Uploads
MAX_UPLOAD_SIZE_MB=10

# Object storage (MinIO / S3-compatible; also used by docker-compose)
S3_ENDPOINT=localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=documents
S3_SECURE=false

# LLM (provider: anthropic | openai)
LLM_PROVIDER=openai
LLM_MODEL=gpt-6-luna
LLM_API_KEY=
LLM_MAX_TOKENS=16000
LLM_TIMEOUT_SECONDS=120
PROMPT_VERSION=v2

# Document reading (scanned PDFs and images go to the vision model)
PDF_MAX_PAGES=50
VISION_MAX_PAGES=10

# Queue (Celery + Redis)
REDIS_URL=redis://localhost:6379/0
JOB_MAX_RETRIES=3
JOB_RETRY_BACKOFF_SECONDS=10

# Webhooks (job.completed / job.failed notifications, configured per API key)
# true allows http:// and private/loopback URLs; local development only, never in production
WEBHOOK_ALLOW_INSECURE_URLS=false
WEBHOOK_TIMEOUT_SECONDS=10
WEBHOOK_MAX_RETRIES=5
WEBHOOK_RETRY_BACKOFF_SECONDS=30
