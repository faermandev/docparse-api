# Copy to .env and adjust. Loaded by app/core/config.py.
APP_ENV=development
LOG_LEVEL=INFO

# PostgreSQL (used by docker-compose and the app)
POSTGRES_USER=docs
POSTGRES_PASSWORD=docs
POSTGRES_DB=docs_extraction
DATABASE_URL=postgresql+psycopg://docs:docs@localhost:5432/docs_extraction

# Uploads (local disk until MinIO is added)
STORAGE_DIR=storage
MAX_UPLOAD_SIZE_MB=10

# LLM (provider: anthropic | openai)
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-5-5
LLM_API_KEY=
LLM_MAX_TOKENS=16000
LLM_TIMEOUT_SECONDS=120
PROMPT_VERSION=v1
